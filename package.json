    "webtoon-preview": "node scripts/webtoon-preview.mjs",
    "test:webtoon": "node scripts/test-webtoon.mjs",
    "webtoon-draw": "node scripts/webtoon-draw.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
