{
  "name": "doheeplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "npm run validate && npm run build && node scripts/test-webtoon.mjs --no-browser",
    "new-game": "node scripts/new-game.mjs",
    "new-webtoon": "node scripts/new-webtoon.mjs",
    "validate": "node scripts/validate-game.mjs && node scripts/validate-webtoon.mjs",
